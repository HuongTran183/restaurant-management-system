# Dedicated local ports for this repo.
# Copy to `.env` at the repo root when you want compose and backend host mode
# to share one custom port set on your machine.

APP_FRONTEND_PORT=15173
APP_FRONTEND_PREVIEW_PORT=14173
APP_BACKEND_PORT=18080
APP_DB_PORT=13306
APP_DB_HOST=localhost

APP_QR_PUBLIC_BASE_URL=http://127.0.0.1:15173/qr
VITE_API_BASE_URL=http://127.0.0.1:18080
VITE_API_PROXY_TARGET=http://127.0.0.1:18080
# APP_CORS_ALLOWED_ORIGINS=http://127.0.0.1:15173,http://localhost:15173,http://192.168.1.25:15173

PLAYWRIGHT_BASE_URL=http://127.0.0.1:15173
PLAYWRIGHT_API_BASE_URL=http://127.0.0.1:18080
PLAYWRIGHT_API_HEALTHCHECK_URL=http://127.0.0.1:18080/actuator/health
